# --- Application ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# AI features (optional; the app runs without it)
OPENAI_API_KEY=

# --- Database tests ------------------------------------------------------
# `npm run test:db` creates and deletes real rows with the service-role key.
# Point it at a DEDICATED test project with the same migrations applied.
# If these are unset it falls back to the app credentials above, and refuses
# to run when that resolves to the production project.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=

# The project ref the test guard refuses to touch. Defaults to the known
# production ref; set it if production moves.
PRODUCTION_SUPABASE_PROJECT_REF=

# Escape hatch for a single deliberate local run. Never set this in CI.
# ALLOW_PROD_TEST_DB=1
